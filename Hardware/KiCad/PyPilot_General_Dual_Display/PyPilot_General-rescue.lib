#encoding utf-8
#
# Hall_Angle_Sensor-General_Library
#
DEF Hall_Angle_Sensor-General_Library U 0 40 Y Y 1 F N
F0 "U" 0 100 50 H V C CNN
F1 "Hall_Angle_Sensor-General_Library" 0 0 50 H V C CNN
F2 "" 200 -400 50 H I C CNN
F3 "" 200 -400 50 H I C CNN
DRAW
C 400 -300 224 0 1 0 f
X GND 1 700 -400 100 L 50 50 1 1 I
X Out 2 700 -300 100 L 50 50 1 1 O
X 5V 3 700 -200 100 L 50 50 1 1 I
ENDDRAW
ENDDEF
