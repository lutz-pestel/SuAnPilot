EESchema-LIBRARY Version 2.4
#encoding utf-8
#
# Motor_Controller-General_Library
#
DEF Motor_Controller-General_Library U 0 40 Y Y 1 F N
F0 "U" 0 0 50 H V C CNN
F1 "Motor_Controller-General_Library" 0 -100 50 H V C CNN
F2 "" 0 0 50 H I C CNN
F3 "" 0 0 50 H I C CNN
DRAW
S -600 -200 800 -1000 0 1 0 f
X 12V(red) ~ -700 -300 100 R 50 50 1 1 W
X 5V_out ~ 900 -300 100 L 50 50 1 1 O
X Clutch(yellow) ~ -700 -700 100 R 50 50 1 1 O
X GND ~ 900 -900 100 L 50 50 1 1 P
X GND ~ 900 -500 100 L 50 50 1 1 P
X GND(black) ~ -700 -400 100 R 50 50 1 1 W
X Motor_A(green) ~ -700 -500 100 R 50 50 1 1 O
X Motor_B(green) ~ -700 -600 100 R 50 50 1 1 O
X Rudder_Angle_in ~ 900 -400 100 L 50 50 1 1 I
X RX(3.3V) ~ 900 -700 100 L 50 50 1 1 I
X TX(3.3V) ~ 900 -800 100 L 50 50 1 1 O
ENDDRAW
ENDDEF
