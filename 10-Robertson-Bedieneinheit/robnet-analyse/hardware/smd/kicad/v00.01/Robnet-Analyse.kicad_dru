(version 1)
(rule "Aufdruck der Stecker an der Kante (gewollt)"
  (condition "(A.memberOfFootprint('J1') || A.memberOfFootprint('J2') || A.memberOfFootprint('J3') || A.memberOfFootprint('J5') || B.memberOfFootprint('J1') || B.memberOfFootprint('J2') || B.memberOfFootprint('J3') || B.memberOfFootprint('J5')) && (A.Layer == 'F.Silkscreen' || B.Layer == 'F.Silkscreen')")
  (constraint silk_clearance (min -10mm))
  (constraint edge_clearance (min -10mm))
  (severity ignore))
