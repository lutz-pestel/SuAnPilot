# Robnet-Analyse: Oszilloskop-Oberfläche. Version 00.03, Stand 07.11.2026.
# Liegt auf dem Raspberry unter /etc/systemd/system/. Root wegen /dev/mem und Herunterfahren.
[Unit]
Description=Robnet Oszilloskop
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/robnet/oszilloskop_v00.03.py
WorkingDirectory=/home/pi/robnet
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
